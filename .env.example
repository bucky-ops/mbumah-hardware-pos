# MBUMAH HARDWARE POS & ERP - Self-Hosting Environment Configuration
# Copy this file to .env and fill in the values for your deployment.
# NEVER commit your .env file to version control.
#
# Quick start:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose -f docker-compose.prod.yml up -d

# DATABASE
# PostgreSQL credentials for the Docker Compose stack.
# These are used by both the postgres container AND the app container.
# IMPORTANT: Change the password from the default for production!
POSTGRES_USER=mbumah
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=mbumah_pos

# The app container uses these internal URLs to connect to postgres.
# They are constructed automatically in docker-compose.prod.yml using the
# POSTGRES_USER/PASSWORD/DB values above. You do NOT need to set these
# manually unless you are using an external database.
# DATABASE_URL=postgresql://mbumah:password@postgres:5432/mbumah_pos?sslmode=disable&connect_timeout=15
# DIRECT_URL=postgresql://mbumah:password@postgres:5432/mbumah_pos?sslmode=disable&connect_timeout=30

# AUTHENTICATION
# NextAuth.js secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Full URL of your deployed app (no trailing slash).
# Use https:// if SSL is configured, http:// if testing without SSL.
NEXTAUTH_URL=https://your-server.com
# JWT secret for custom token auth - generate with: openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# APPLICATION
NEXT_PUBLIC_APP_URL=https://your-server.com
NEXT_PUBLIC_CURRENCY=KES

# NGINX / SSL
# Ports to expose on the host. Defaults to 80 (HTTP) and 443 (HTTPS).
# Change if you already have services on those ports.
# HTTP_PORT=80
# HTTPS_PORT=443

# M-PESA DARAJA API (Safaricom)
# Register at https://developer.safaricom.co.ke/ to get credentials.
# Required for M-Pesa STK Push payments.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# Set to "production" when going live with real M-Pesa transactions.
# Keep as "sandbox" for testing with Safaricom's test environment.
MPESA_ENVIRONMENT=sandbox
# Callback URL for M-Pesa STK Push results.
# Must be publicly accessible (e.g., https://your-server.com/api/payments/mpesa/callback)
MPESA_CALLBACK_URL=https://your-server.com/api/payments/mpesa/callback

# NOTIFICATIONS (Optional)
# Resend for email notifications (https://resend.com/)
# RESEND_API_KEY enables real email delivery (vouchers, receipts, alerts).
# Without it, email sends are recorded as FAILED (never "Sent").
# RESEND_FROM_EMAIL overrides the "From" address; default is
#   MBUMAH HARDWARE <noreply@mbumahhardware.co.ke>
RESEND_API_KEY=
# RESEND_FROM_EMAIL="MBUMAH HARDWARE <noreply@yourdomain.com>"

# Twilio for SMS + WhatsApp notifications (https://www.twilio.com/)
# Without these, SMS/WhatsApp sends are recorded as FAILED / Simulated (never
# "Sent") and the UI offers a wa.me deep-link or copy fallback instead.
#
# From-number aliases (first match wins, matches src/lib/notification-helpers.ts):
#   general / account number : TWILIO_FROM_PHONE → TWILIO_PHONE_NUMBER
#   SMS sender override      : TWILIO_SMS_FROM → (general number above)
#   WhatsApp sender          : TWILIO_WHATSAPP_FROM (defaults to the Twilio sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
# TWILIO_PHONE_NUMBER=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# UPDATES / ROLLBACK / BACKUP (Optional - v2.9.0)
# Powers the admin "Updates, rollback & backups" panel and the crash-backup
# hook. All optional - the features degrade honestly when unset.
#
# VERCEL_TOKEN: Vercel API token (Account Settings → Tokens, scope: full or
#  deployments:write) - enables the "Roll back production" button.
# VERCEL_PROJECT_ID: the Vercel project id (Project Settings → General).
# VERCEL_TEAM_ID: only when the project lives in a team (Team Settings).
# GITHUB_TOKEN: GitHub token (read scope is enough) - raises the anonymous
#   60 req/h limit for the release/update check.
# BACKUP_DIR: where crash + manual backups are written. Default on Windows
#   laptops: Desktop\MbumahBackups; on cloud: <tmpdir>/mbumah-backups.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# GITHUB_TOKEN=
# BACKUP_DIR=

# REDIS (Optional - for production caching & sessions)
# If you have a Redis instance running, uncomment and set the URL.
# Can be added to docker-compose.prod.yml as a service if needed.
# REDIS_URL=redis://redis:6379

# DIAGNOSTICS (DO NOT USE IN PRODUCTION)
# Exposes full error details in 500 responses for debugging.
# ONLY enable temporarily while diagnosing production issues.
# EXPOSE_ERRORS=true

# REMOTE ACCESS KIT / FLEET OPS (Optional - v2.11.0)
# Powers the Admin "Fleet & Remote Ops" console: issue signed update/rollback/
# freeze commands to store laptops and read their audit ledgers. All optional -
# the console degrades honestly when unset. Full design:
#   docs/REMOTE_ACCESS_KIT_PLAN.md
#
# OPS_GITHUB_TOKEN: fine-grained PAT - Repository access = ONLY mbumah-ops-log,
#   Permissions = Contents: Read and write. Never point it at the main repo.
# OPS_LOG_REPO: private ops-log repo (default bucky-ops/mbumah-ops-log).
# OPS_SIGNING_KEY: 32-byte hex secret shared with every kit's .env - commands
#   are HMAC-signed here and verified by the agent on the laptop.
# OPS_GITHUB_TOKEN=
# OPS_LOG_REPO=bucky-ops/mbumah-ops-log
# OPS_SIGNING_KEY=
