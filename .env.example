# Mbumah Hardware POS — environment template (v2.18.2)
# Copy to .env and fill in. NEVER commit real secrets.

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./db/custom.db"
AUTH_SECRET="change-me-to-a-random-32+-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Update channel (Windows updater) ────────────────────────────────────────
UPDATE_CHANNEL="stable"          # stable | hotfix

# ── M-Pesa Daraja (optional; demo STK push works without) ───────────────────
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_ENV="sandbox"              # sandbox | production
MPESA_CALLBACK_URL=""

# ── SMS / WhatsApp (optional; reminders log as SIMULATED when empty) ────────
SMS_API_KEY=""
SMS_SENDER_ID=""

# ── eTIMS (optional) ────────────────────────────────────────────────────────
ETIMS_ENDPOINT=""
ETIMS_USERNAME=""
ETIMS_PASSWORD=""
