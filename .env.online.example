# Mbumah Hardware POS — online/production template (v2.18.2)
# Vercel/Neon or VPS + Postgres; wildcard DNS *.mbumah.co.ke for subdomain
# workspaces (juja-main.mbumah.co.ke …). See docs/subdomain-workspaces.md.

DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
DIRECT_URL="postgres://user:pass@host/db?sslmode=require"
AUTH_SECRET="openssl rand -hex 32"
NEXTAUTH_URL="https://app.mbumah.co.ke"

UPDATE_CHANNEL="stable"
WORKSPACE_MODE="subdomain"
ROOT_DOMAIN="mbumah.co.ke"

# M-Pesa Daraja (production)
MPESA_ENV="production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://app.mbumah.co.ke/api/payments/mpesa/callback"
