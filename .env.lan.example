# Mbumah Hardware POS — LAN deployment template (v2.18.2)
# Branch servers on the shop LAN; workstations hit http://<server-ip>:3000.

DATABASE_URL="file:/var/lib/mbumah/pos.db"
AUTH_SECRET="generate-with: openssl rand -hex 32"
NEXTAUTH_URL="http://192.168.1.10:3000"
NEXTAUTH_TRUST_HOST="true"

UPDATE_CHANNEL="stable"

# LAN workspaces use path mode (/stores/<code>/dashboard) — subdomain mode
# needs dnsmasq + hosts entries per docs/local-offline-setup.md.
WORKSPACE_MODE="path"

MPESA_ENV="sandbox"
