# ============================================================================
# MBUMAH HARDWARE POS - Local offline subdomain mode (mbumah.test)
# ============================================================================
# Copy this file to .env for a single-shop offline install where every branch
# should behave like its own website (juja-main.mbumah.test, thika.mbumah.test,
# ...). Pair it with the hosts-file helper:
#
#   npm run domains:write-hosts     (writes the managed hosts block)
#   npm run domains:print           (print-only fallback)
#   npm run domains:verify          (PASS/FAIL matrix against a running server)
#
# Full guide: docs/local-offline-setup.md
# ============================================================================

# ─── DATABASE (SQLite - one file, one shared database for all branches) ─────
DATABASE_URL=file:./prisma/dev.db
DIRECT_URL=file:./prisma/dev.db

# ─── WORKSPACE MODE (branch subdomains on the offline root domain) ──────────
# The default host allowlist automatically includes the root domain and its
# subdomains once NEXT_PUBLIC_ROOT_DOMAIN is set (see src/lib/workspace/config.ts).
NEXT_PUBLIC_ROOT_DOMAIN=mbumah.test
NEXT_PUBLIC_STORE_WORKSPACE_MODE=auto

# ─── AUTHENTICATION ────────────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Plain HTTP locally: the shared cookie must NOT be marked secure, and the
# leading dot gives single sign-on across mbumah.test and every branch.
NEXTAUTH_URL=http://mbumah.test:3000
NEXT_PUBLIC_APP_URL=http://mbumah.test:3000
NEXTAUTH_COOKIE_DOMAIN=.mbumah.test
NEXTAUTH_COOKIE_SECURE=false

# ─── APPLICATION ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=KES
APP_PORT=3000
APP_MODE=local-offline

# ─── M-PESA (offline mode: sandbox credentials, callback via the local host) ─
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=http://mbumah.test:3000/api/payments/mpesa/callback
