# ============================================================================
# MBUMAH HARDWARE POS — No-Docker Laptop Configuration (Node.js + SQLite)
# ============================================================================
# The installer (deploy/nodocker/install-nodocker.ps1 or .sh) creates .env
# from this template and fills in the secrets + database path automatically.
#
# Database = ONE SQLite file on disk. No database server. Back up the whole
# system by copying that one file.
# ============================================================================

# ─── DATABASE (SQLite — no server, set automatically by installer) ──────────
DATABASE_URL=file:CHANGE_ME/mbumah-pos-data/pos.db
DIRECT_URL=file:CHANGE_ME/mbumah-pos-data/pos.db

# ─── AUTHENTICATION ────────────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
# MUST match the URL typed in the browser.
#   This laptop only:        http://localhost:3000
#   Phones / other PCs:      http://<laptop-ip>:3000  (set BOTH lines)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── APPLICATION ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=KES
APP_PORT=3000

# ─── BACKGROUND JOBS (deploy/nodocker/cron-local.mjs) ───────────────────────
CRON_SECRET=CHANGE_ME

# ─── FIRST-RUN SEEDING ───────────────────────────────────────────────────────
# true on first run only (creates admin + demo data). Set to false after the
# first successful login — the seed re-creates its demo users on every run.
SEED_DATABASE=true

# ─── M-PESA DARAJA (Safaricom) — optional ───────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# "sandbox" for testing, "production" for live
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=

# ─── NOTIFICATIONS (optional) ────────────────────────────────────────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
