# ============================================================================
# MBUMAH HARDWARE POS - LAN mode (mbumah.lan or the static server IP)
# ============================================================================
# Copy to .env on the SHOP SERVER (the machine every till and phone points
# at). Pair with docs/lan-deployment.md: dnsmasq or the router DNS resolves
# mbumah.lan and *.mbumah.lan for the whole network; devices without custom
# DNS keep working through the raw IP (path mode).
#
#   npm run domains:print -- --domain mbumah.lan --ip 192.168.1.20
#   npm run domains:write-hosts -- --domain mbumah.lan --ip 192.168.1.20
#
# ============================================================================

# ─── DATABASE (SQLite - one file on the server, all branches share it) ──────
DATABASE_URL=file:./mbumah-pos-data/pos.db
DIRECT_URL=file:./mbumah-pos-data/pos.db

# ─── WORKSPACE MODE ─────────────────────────────────────────────────────────
# The default host allowlist covers the root domain and its subdomains once
# NEXT_PUBLIC_ROOT_DOMAIN is set; raw IP hosts are always allowed.
NEXT_PUBLIC_ROOT_DOMAIN=mbumah.lan
NEXT_PUBLIC_STORE_WORKSPACE_MODE=auto

# ─── AUTHENTICATION (plain HTTP on the LAN) ─────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Static LAN IP variant (recommended for POS - DHCP reservations on the router):
#   NEXTAUTH_URL=http://192.168.1.20:3000
#   NEXT_PUBLIC_APP_URL=http://192.168.1.20:3000
NEXTAUTH_URL=http://mbumah.lan:3000
NEXT_PUBLIC_APP_URL=http://mbumah.lan:3000
NEXTAUTH_COOKIE_DOMAIN=.mbumah.lan
NEXTAUTH_COOKIE_SECURE=false

# ─── APPLICATION ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=KES
APP_PORT=3000
APP_MODE=local-offline

# ─── M-PESA (no public callback on a LAN - keep mock, or sandbox + tunnel) ──
MPESA_ENVIRONMENT=mock
MPESA_CALLBACK_URL=http://mbumah.lan:3000/api/payments/mpesa/callback
