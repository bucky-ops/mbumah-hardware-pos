# ============================================================================
# MBUMAH HARDWARE POS — Laptop / Standalone Environment Configuration
# ============================================================================
# Copy this file to the REPO ROOT as `.env` (the install scripts do this for
# you and auto-generate the secrets):
#
#   cp deploy/laptop/.env.laptop.example .env
#
# Then: docker compose -f docker-compose.laptop.yml up -d --build
# ============================================================================

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Used by the local postgres container. CHANGE the default password!
POSTGRES_USER=mbumah
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mbumah_pos

# App→DB URL is built automatically inside docker-compose.laptop.yml.
# Only set these if pointing at an external database instead.
# DATABASE_URL=postgresql://mbumah:password@postgres:5432/mbumah_pos?sslmode=disable&connect_timeout=15
# DIRECT_URL=postgresql://mbumah:password@postgres:5432/mbumah_pos?sslmode=disable&connect_timeout=30

# ─── AUTHENTICATION ──────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_32
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_32

# MUST match what you type in the browser.
#   - On the laptop itself:      http://localhost:3000
#   - From phones/other PCs:     http://<laptop-LAN-IP>:3000  (set BOTH to the
#     LAN IP if cashiers/other devices will connect — recommended for POS)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── APPLICATION ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=KES
# Host port for the POS (change if 3000 is already in use)
APP_PORT=3000

# ─── BACKGROUND JOBS (local cron container) ─────────────────────────────────
# Shared secret between the cron container and the API routes.
# Generate with: openssl rand -base64 32
CRON_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_32

# ─── FIRST-RUN SEEDING ───────────────────────────────────────────────────────
# Set to true for the FIRST RUN ONLY — creates the Super Admin + demo data.
# AFTER the first successful login, set this back to false and restart,
# because the seed re-creates its demo users on every run.
SEED_DATABASE=true

# ─── M-PESA DARAJA API (Safaricom) ──────────────────────────────────────────
# Register at https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# "sandbox" for testing, "production" for live transactions
MPESA_ENVIRONMENT=sandbox
# Public HTTPS callback (leave empty for laptop-only sandbox testing;
# production M-Pesa requires a publicly reachable HTTPS URL)
MPESA_CALLBACK_URL=

# ─── NOTIFICATIONS (Optional) ────────────────────────────────────────────────
# Email via Resend (https://resend.com/)
RESEND_API_KEY=
# SMS/WhatsApp via Twilio (https://www.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── REDIS (Optional) ────────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379

# ─── DIAGNOSTICS (DO NOT USE IN PRODUCTION) ──────────────────────────────────
# EXPOSE_ERRORS=true
