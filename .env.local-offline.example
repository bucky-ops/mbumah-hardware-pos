# Mbumah Hardware POS — local/offline template (v2.18.2)
# Single-laptop offline POS. Carts queue in Dexie (localStorage/IndexedDB) and
# sync when connectivity returns; receipts print via ESC/POS.

DATABASE_URL="file:./db/custom.db"
AUTH_SECRET="any-32-plus-char-secret-for-this-laptop"
NEXTAUTH_URL="http://localhost:3000"

UPDATE_CHANNEL="hotfix"          # offline laptops take hotfix channel first
WORKSPACE_MODE="path"            # localhost has no subdomain DNS

# Offline-first: no external services configured — M-Pesa and SMS stay in
# SIMULATED mode until keys are added.
