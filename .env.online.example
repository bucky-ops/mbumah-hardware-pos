# ============================================================================
# MBUMAH HARDWARE POS - ONLINE TUNNEL mode (public subdomains, own domain)
# ============================================================================
# Copy to .env on the server that hosts the app when the whole organization
# is served ONLINE from your own domain through a tunnel or reverse proxy:
#
#   app.mbumah.co.ke            organization console (root workspace)
#   juja-main.mbumah.co.ke      branch workspace per branch (wildcard DNS)
#
# Pair with docs/online-hosting.md, which covers the two supported front
# doors: Cloudflare Tunnel (named tunnel + wildcard DNS route) and a Caddy
# reverse proxy (automatic HTTPS). This template is for the self-hosted
# public setup; the fully managed alternative is Vercel
# (docs/vercel-deployment.md) and the offline alternatives are
# .env.local-offline.example and .env.lan.example.
#
# NOTE: raw localhost (localhost, 127.0.0.1, ::1) and raw LAN IPs always
# fall back to path mode (/stores/{slug}/...) automatically - the workspace
# resolver treats them as the root domain, so a local terminal or a curl
# smoke test keeps working even with subdomains enabled.
# ============================================================================

# ─── WORKSPACE MODE (branch subdomains on the public root domain) ───────────
# Master switch: a host matching {store}.{root domain} serves that branch.
NEXT_PUBLIC_USE_SUBDOMAINS=true
# auto: subdomains when the host is a valid branch subdomain, path mode on
# localhost / raw IPs. Leave on auto unless debugging.
NEXT_PUBLIC_STORE_WORKSPACE_MODE=auto
# The public root domain. Every branch subdomain lives under it.
NEXT_PUBLIC_ROOT_DOMAIN=mbumah.co.ke

# ─── AUTHENTICATION (public HTTPS) ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
# The canonical public URL of the organization console (no trailing slash).
NEXTAUTH_URL=https://app.mbumah.co.ke
NEXT_PUBLIC_APP_URL=https://app.mbumah.co.ke
# Shared session cookie: the leading dot gives single sign-on across the
# console and every branch subdomain. Public HTTPS means the cookie MUST be
# marked secure. SameSite=lax keeps normal top-level navigation working.
NEXTAUTH_COOKIE_DOMAIN=.mbumah.co.ke
NEXTAUTH_COOKIE_SECURE=true
NEXTAUTH_COOKIE_SAME_SITE=lax

# ─── HOST ALLOWLIST (host header attacks are rejected with 403) ─────────────
# The console host, the branch wildcard, the bare root domain, and plain
# localhost for local smoke tests. Unknown hosts never reach the app.
ALLOWED_HOSTS=app.mbumah.co.ke,*.mbumah.co.ke,mbumah.co.ke,localhost,127.0.0.1

# ─── FORWARDED HOST TRUST (only behind Cloudflare Tunnel / Caddy / nginx) ───
# When a front door rewrites the Host header (or the app sits behind more
# than one hop), the client-visible hostname arrives in x-forwarded-host.
# Setting this to true makes the workspace pipeline read that header.
# SECURITY: enable ONLY behind a proxy or tunnel that OVERWRITES
# x-forwarded-host on every request. Never enable it on a directly exposed
# server - any client could spoof the header and impersonate another
# workspace origin. Default is false (header ignored).
TRUST_X_FORWARDED_HOST=true

# ─── DATABASE (production PostgreSQL) ──────────────────────────────────────
# Online mode is a production deployment: use managed PostgreSQL (Neon,
# RDS, self-hosted postgres), not SQLite. DIRECT_URL is the non-pooled
# endpoint used by schema tooling (migrations, db push); DATABASE_URL may
# point at the pooled endpoint when the provider offers pooling.
# DATABASE_URL=postgresql://user:password@host:5432/mbumah_pos?sslmode=require
# DIRECT_URL=postgresql://user:password@host:5432/mbumah_pos?sslmode=require

# ─── M-PESA (public HTTPS callback required for real STK Push) ─────────────
# Daraja needs a reachable public HTTPS callback; behind the tunnel the
# console host is reachable, so the root callback works for every branch
# (the callback resolves the store from the transaction, one URL for all).
# MPESA_ENVIRONMENT=production
# MPESA_CALLBACK_URL=https://app.mbumah.co.ke/api/payments/mpesa/callback

# ─── APPLICATION ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=KES
APP_MODE=production
